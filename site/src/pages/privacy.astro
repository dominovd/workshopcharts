---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site.ts';

/**
 * Privacy.
 *
 * Written to describe THIS site, which is static, has no accounts and sets no
 * cookies. A boilerplate policy listing cookie categories the site does not have
 * would be the same kind of untrue-but-conventional claim as "Made in the USA" in
 * the footer, on a site whose whole pitch is that its statements are checkable.
 *
 * The note here used to say "if analytics are ever added, this page has to change in
 * the same commit". Analytics were added, and this is that change. Vercel Web
 * Analytics is cookieless and stores no IP address, but it does record page views,
 * and the honest version of this page names what it collects rather than keeping the
 * old sentence that said nothing was loaded at all.
 */
---

<Base
  title="Privacy | Workshop Charts"
  description="No accounts, no cookies and no advertising. What the cookieless page-view analytics records, what the host logs, and what happens to email you send here."
>
  <div class="shell page">
    <header class="page__head">
      <p class="eyebrow">Privacy</p>
      <h1>Privacy</h1>
      <p class="lede">
        Short, because the site does very little. Last updated 17 August 2026.
      </p>
    </header>

    <div class="prose">
      <h2>No accounts, no cookies, no advertising</h2>
      <p>
        There is nothing to sign up for, so there is no account and no password. This
        site sets no cookies, loads no advertising and no social widgets, and runs no
        session recording. Fonts are served from this domain rather than a third-party
        font service, so rendering a page does not report your visit to a font host.
      </p>

      <h2>Page-view analytics</h2>
      <p>
        The site counts page views using Vercel Web Analytics, which is cookieless.
        It sets no cookie and writes nothing to your browser's storage; a visit is
        identified by a hash of the request, and that hash is discarded after 24 hours.
        No IP address is stored, and nothing is kept that would let anyone reconstruct
        your browsing across sites or identify you.
      </p>
      <p>What is recorded with each page view:</p>
      <ul>
        <li>the time, and the page you opened</li>
        <li>the referring site, if you arrived from a link</li>
        <li>approximate location: country, region, city</li>
        <li>browser, operating system and device type, with versions</li>
      </ul>
      <p>
        That is used to see which charts people reach for, which is the only question
        this project asks of its traffic. There is no advertising to target and nothing
        is sold or shared.
      </p>

      <h2>What the host records</h2>
      <p>
        Like any web server, the host that serves these files keeps ordinary request
        logs: the IP address that made the request, the page requested, the time, and
        the browser's user-agent string. Those logs exist to keep the site running and
        to detect abuse. They are not combined with anything else, not used to build a
        profile, and not sold or shared for advertising.
      </p>

      <h2>Email you send</h2>
      <p>
        Mail to <a href={`mailto:${SITE.email}`}>{SITE.email}</a> is used to answer it.
        Corrections may be kept in the project's notes alongside the chart they concern,
        because a record of why a figure changed is part of the point. That record does
        not include your address unless you ask to be credited. There is no mailing
        list, so there is nothing to unsubscribe from.
      </p>

      <h2>Files you download</h2>
      <p>
        The PDF and PNG sheets are ordinary static files. They contain no tracking
        pixels and no embedded identifiers, and they do not phone home when opened or
        printed.
      </p>

      <h2>Children</h2>
      <p>
        The site collects nothing from anyone, of any age. It is used in classrooms, and
        an instructor can hand out these sheets without a pupil's data going anywhere.
      </p>

      <h2>If this changes</h2>
      <p>
        If anything else is ever added that observes visitors, this page says so and
        carries the date it changed. It has already worked that way once: the analytics
        section above was written in the same change that added the analytics. A privacy
        page describing a site's intentions rather than its behaviour is worth nothing.
      </p>

      <h2>Questions</h2>
      <p>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </div>
  </div>
</Base>

<style>
  .page {
    padding-block: var(--s-6) var(--s-7);
    max-width: 76ch;
  }

  h1 {
    margin-top: var(--s-2);
    font-size: clamp(2.2rem, 5.5vw, 3.2rem);
  }

  .lede {
    margin-top: var(--s-3);
  }

  .prose {
    margin-top: var(--s-6);
  }

  .prose h2 {
    font-size: var(--step-2);
    margin-top: var(--s-6);
  }

  .prose h2:first-child {
    margin-top: 0;
  }

  .prose p {
    margin-top: var(--s-3);
    color: var(--ink-2);
  }
</style>
