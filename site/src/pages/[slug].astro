---
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import ChartTable from '../components/ChartTable.astro';
import ChartControls from '../components/ChartControls.astro';
import ArtifactBar from '../components/ArtifactBar.astro';
import SourceBlock from '../components/SourceBlock.astro';
import SheetPreview from '../components/SheetPreview.astro';
import SeriesPanel from '../components/SeriesPanel.astro';
import { publishedCharts, trades, chartBySlug } from '../data/registry.ts';
import type { Chart } from '../data/schema.ts';

/**
 * The chart page.
 *
 * Only published charts get a route. A held chart has no page at all — not a
 * stub, not a "coming soon" — so there is no URL that can accidentally rank for
 * a table nobody has checked.
 */
export const getStaticPaths = (() =>
  publishedCharts.map((chart) => ({
    params: { slug: chart.slug },
    props: { chart },
  }))) satisfies GetStaticPaths;

interface Props {
  chart: Chart;
}
const { chart } = Astro.props;
const trade = trades.find((t) => t.id === chart.trade)!;
const related = (chart.related ?? [])
  .map((slug) => chartBySlug(slug))
  .filter((c): c is Chart => Boolean(c));

const faqSchema = chart.faq
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: chart.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: chart.title,
  description: chart.metaDescription,
  url: new URL(`/${chart.slug}/`, Astro.site).href,
  inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', name: 'Workshop Charts', url: Astro.site?.href },
  // The date the data was checked, not the date the page was deployed. The whole
  // point of tracking it is that it means something.
  dateModified: chart.verification.verifiedOn,
  primaryImageOfPage: {
    '@type': 'ImageObject',
    contentUrl: new URL(`/sheets/${chart.slug}.png`, Astro.site).href,
    width: 1000,
    height: 1500,
    caption: chart.imageAlt,
  },
  citation: chart.sources
    .filter((s) => !s.definitional)
    .map((s) => ({ '@type': 'CreativeWork', name: s.standard, publisher: s.publisher })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: trade.label, item: new URL('/charts/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: chart.title },
  ],
};
---

<Base
  title={chart.metaTitle}
  description={chart.metaDescription}
  printOrientation={chart.printOrientation}
  ogImage={`/sheets/${chart.slug}.png`}
  ownSchema
>
  {/* WebPage + FAQPage + BreadcrumbList. Not WebApplication: this is a
       reference page, not an app. */}
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />}

  <nav class="crumbs shell no-print" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href="/charts/">{trade.label}</a></li>
      <li aria-current="page">{chart.title}</li>
    </ol>
  </nav>

  <div class="shell chart-page print-sheet">
    <header class="chart-head">
      <div>
        <p class="eyebrow">{trade.label} reference</p>
        <h1>{chart.title}</h1>
        <p class="subtitle">{chart.subtitle}</p>
      </div>

      <ul class="badges no-print">
        <li>
          <span class="badges__k mono">Basis</span>
          <span class="badges__v">
            {chart.verification.status === 'derived' ? 'Computed from definitions' : 'Sight-checked'}
          </span>
        </li>
        <li>
          <span class="badges__k mono">Last checked</span>
          <span class="badges__v mono">{chart.verification.verifiedOn}</span>
        </li>
        <li>
          <span class="badges__k mono">Sheet</span>
          <span class="badges__v">{chart.printOrientation}</span>
        </li>
      </ul>
    </header>

    {/* Filter above the table: on a phone a reference table is searched, not read,
      and horizontal scroll inside a table breaks page scroll (§5).

      The source block sits INSIDE `.chart-view` deliberately. Toggle state lives
      on this element, so anything that has to move with the data has to be within
      its subtree — a citation that stays put while the columns it describes leave
      the table is the failure mode this whole structure exists to prevent. */}
    <div class="chart-view" id="chart-view">
      <ChartControls chart={chart} />
      <div class="table-wrap">
        <ChartTable chart={chart} />
      </div>

      <ArtifactBar chart={chart} />

      <SourceBlock chart={chart} />
    </div>

    <SeriesPanel chart={chart} />

    <SheetPreview chart={chart} />

    {
      chart.howToUse && (
        <section class="howto no-print">
          <h2>How to use this chart</h2>
          <ol>
            {chart.howToUse.map((line) => (
              <li>{line}</li>
            ))}
          </ol>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="related no-print">
          <h2>Related charts</h2>
          <ul>
            {related.map((c) => {
              const published = publishedCharts.includes(c);
              return (
                <li>
                  {published ? (
                    <a href={`/${c.slug}/`}>
                      <strong>{c.title}</strong>
                      <span>{trades.find((t) => t.id === c.trade)!.label}</span>
                      <span aria-hidden="true">→</span>
                    </a>
                  ) : (
                    /* No dead link to a held chart. Naming it and saying why is
                       more useful than a link to nothing, and it is the same
                       promise the rest of the page makes. */
                    <div class="related__held">
                      <strong>{c.title}</strong>
                      <span>In verification, not published yet</span>
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    {
      chart.faq && (
        <section class="faq no-print">
          <h2>Frequently asked questions</h2>
          {chart.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>
      )
    }
  </div>
</Base>

<style>
  .crumbs {
    padding-block: var(--s-3);
    font-size: var(--step--1);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--ink-3);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: var(--s-2);
    color: var(--rule-strong);
  }

  .crumbs a {
    color: var(--ink-2);
    text-decoration: none;
  }

  .chart-page {
    display: grid;
    gap: var(--s-5);
    padding-bottom: var(--s-7);
  }

  .chart-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-4);
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    margin-top: var(--s-2);
  }

  .subtitle {
    margin-top: var(--s-3);
    color: var(--ink-2);
    max-width: 58ch;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .badges li {
    display: grid;
    gap: 2px;
    padding: var(--s-2) var(--s-4);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--cream);
  }

  .badges__k {
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }

  .badges__v {
    font-size: var(--step--1);
    font-weight: 600;
  }

  .chart-view {
    display: grid;
    gap: var(--s-5);
  }

  .table-wrap {
    margin-top: 0;
  }

  /* How to use ------------------------------------------------------------ */
  .howto,
  .related,
  .faq {
    border-top: 1px solid var(--rule);
    padding-top: var(--s-5);
  }

  .howto h2,
  .related h2,
  .faq h2 {
    font-size: var(--step-2);
    margin-bottom: var(--s-3);
  }

  .howto ol {
    margin: 0;
    padding-left: 1.3rem;
    display: grid;
    gap: var(--s-3);
    max-width: 74ch;
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  /* Related --------------------------------------------------------------- */
  .related ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--s-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .related a,
  .related__held {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--s-1) var(--s-3);
    min-height: var(--tap);
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    text-decoration: none;
  }

  .related a:hover {
    border-color: var(--ink);
  }

  .related__held {
    border-style: dashed;
    background: var(--cream);
    color: var(--ink-3);
  }

  .related strong {
    font-size: var(--step-0);
  }

  .related span {
    grid-column: 1;
    font-size: var(--step--2);
    color: var(--ink-3);
  }

  .related a span[aria-hidden] {
    grid-column: 2;
    grid-row: 1 / span 2;
    font-size: var(--step-1);
    color: var(--ink);
  }

  /* FAQ ------------------------------------------------------------------- */
  details {
    border-bottom: 1px solid var(--rule);
    max-width: 78ch;
  }

  summary {
    cursor: pointer;
    padding: var(--s-3) 0;
    font-weight: 600;
    min-height: var(--tap);
    display: flex;
    align-items: center;
  }

  details p {
    padding-bottom: var(--s-4);
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  @media (max-width: 700px) {
    .badges {
      width: 100%;
    }
  }
</style>
