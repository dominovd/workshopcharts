---
/**
 * Top bar plus navigation.
 *
 * The three claims in the top bar are the three things nothing in the search
 * results has at once, and the order matters: free and no-signup are table
 * stakes that competitors happen to fail, and "built from published standards"
 * is the actual differentiator, so it sits last where it reads as the payoff.
 *
 * No Calculators link. There are no calculators yet, and a nav item that leads
 * to a stub is the same defect as an Aluminum toggle with no aluminium data —
 * a control that promises something the site does not have. It enters the nav
 * the day the first one ships.
 */
const links = [
  { href: '/charts/', label: 'Charts' },
  { href: '/for-shop-class/', label: 'For Shop Class' },
  { href: '/how-we-verify/', label: 'How We Verify' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
---

<div class="topbar">
  <div class="shell topbar__inner mono">
    <span>Free to use</span>
    <span aria-hidden="true">·</span>
    <span>No sign-up</span>
    <span aria-hidden="true">·</span>
    <span>Built from published standards</span>
  </div>
</div>

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="wordmark" href="/">
      <span>Workshop</span>
      <span class="wordmark__second">Charts</span>
    </a>

    <nav aria-label="Main">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn btn--quiet header-search" href="/charts/">
      <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
        <circle cx="6.5" cy="6.5" r="4.6" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M10 10L14 14" stroke="currentColor" stroke-width="1.5"></path>
      </svg>
      Find a chart
    </a>
  </div>
</header>

<style>
  .topbar {
    background: var(--cream);
    border-bottom: 1px solid var(--rule);
  }

  .topbar__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    justify-content: center;
    padding-block: 0.55rem;
    font-size: var(--step--2);
    letter-spacing: 0.02em;
    color: var(--ink-2);
  }

  .site-header {
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    padding-block: var(--s-4);
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 0.94;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-decoration: none;
    display: grid;
  }

  /* Colour used as accent and doubled by the underline, never carrying meaning. */
  .wordmark__second {
    border-bottom: 3px solid var(--lime);
    width: fit-content;
  }

  nav {
    margin-inline: auto;
  }

  nav ul {
    display: flex;
    gap: var(--s-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    text-decoration: none;
    font-weight: 500;
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
  }

  nav a[aria-current='page'] {
    box-shadow: inset 0 -3px 0 var(--lime);
  }

  .header-search {
    flex: none;
  }

  @media (max-width: 860px) {
    .site-header__inner {
      flex-wrap: wrap;
      gap: var(--s-3);
    }
    nav {
      order: 3;
      width: 100%;
      margin-inline: 0;
    }
    nav ul {
      gap: var(--s-4);
      overflow-x: auto;
    }
    .header-search {
      margin-left: auto;
    }
  }
</style>
