---
interface Props {
  size?: number;
}

const { size = 36 } = Astro.props;
---

<svg
  class="brand-mark"
  width={size}
  height={size}
  viewBox="0 0 36 36"
  fill="none"
  aria-hidden="true"
>
  <rect x="1" y="1" width="34" height="34" rx="3" fill="currentColor" />
  <path d="M8 9.5h20M8 17.5h20M8 25.5h20" stroke="white" stroke-width="3" />
  <rect x="22" y="14.5" width="6" height="6" fill="var(--lime)" />
</svg>

<style>
  .brand-mark {
    display: block;
    flex: none;
    color: var(--ink);
  }
</style>
